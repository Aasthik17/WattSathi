# App
APP_ENV=development
APP_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Database (local docker-compose default; change for deployment)
DATABASE_URL=postgresql+psycopg://wattsathi:wattsathi_dev_password@localhost:5432/wattsathi

# Authentication — replace before deploying
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-development-password

# Bolna — server-side only
BOLNA_API_BASE_URL=https://api.bolna.ai
BOLNA_API_KEY=
BOLNA_AGENT_ID=

# Protects custom function tools if current Bolna tool configuration supports header auth
WATTSATHI_BOLNA_TOOL_SECRET=replace-with-a-long-random-secret

# Set only if configured/supported in current Bolna webhook settings
BOLNA_WEBHOOK_SECRET=

# Upload controls
MAX_UPLOAD_MB=20
UPLOAD_STORAGE_PATH=./storage/uploads

# Optional private object storage for production (do not use local filesystem on ephemeral hosts)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Voice cost controls (application-side warnings only; not a provider-enforced hard cap)
VOICE_TEST_MAX_SECONDS=150
VOICE_TEST_REQUIRES_CONFIRMATION=true
